# Copy to .env in the proxy/ directory (git-ignored) or export before running.
# The proxy loads .env automatically via `just` (dotenv).
# Only PRUSA_EMAIL and PRUSA_PASSWORD are required; everything else has a default.

# --- Prusa account (required) ---
PRUSA_EMAIL=you@example.com
PRUSA_PASSWORD=your-prusa-password

# --- Target selection (optional; auto-detected if the account has one printer/camera) ---
# PRUSA_PRINTER_UUID=
# PRUSA_CAMERA_ID=

# --- Local RTSP output ---
RTSP_PORT=8554
# RTSP_PATH=live            # default: slug of the camera name
RTSP_BIND_ADDR=0.0.0.0
IDLE_TIMEOUT_SECONDS=60     # tear down WebRTC this long after the last viewer leaves

# --- Token cache & health ---
TOKEN_STORE_PATH=/data/tokens.json
HEALTH_PORT=8080
METRICS_INTERVAL_SECONDS=60

# --- Snapshots ---
SNAPSHOT_INTERVAL_SECONDS=10
SNAPSHOT_MAX_WIDTH=1920
SNAPSHOT_JPEG_QUALITY=75

# --- MQTT / Home Assistant discovery (optional) ---
# MQTT_BROKER_URL=mqtt://broker.local:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_TOPIC_PREFIX=buddy3d-proxy
