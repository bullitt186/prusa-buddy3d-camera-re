; Copy to config.ini and fill in. config.ini is git-ignored (holds a live secret).
;
; token       - camera registration token from Prusa Connect
;               (Web UI or app > Camera > Token, or the "add camera" QR screen).
;               This is the credential that authenticates this device AS the camera.
; fingerprint - generated automatically from wlan0 exactly like firmware 3.1.6:
;               md5("AA:BB:CC:DD:EE:FF").hexdigest(). Do not configure it here.

[identity]
token = <REGISTRATION_TOKEN>

[camera]
width = 1920
height = 1080

[upload]
interval = 10
server = webcam.connect.prusa3d.com
