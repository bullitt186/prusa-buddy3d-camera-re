# GStreamer RTSP server (rtsp_server.py) -> rtsp://<pi>:8554/live.
# Pulls from the rpicam-source TCP stream. main.py starts/stops this on demand.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=Local RTSP server for Prusa camera
After=network.target data-ready.target rpicam-source.service
Requires=rpicam-source.service data-ready.target

[Service]
Type=simple
User=prusa-cam
WorkingDirectory=/opt/prusa-cam
# WP-R4c: start through the launcher so an installed signed release under DATA
# (and its per-release venv) runs; the launcher falls back to the factory app.
ExecStart=/opt/prusa-cam/launcher.sh rtsp_server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
