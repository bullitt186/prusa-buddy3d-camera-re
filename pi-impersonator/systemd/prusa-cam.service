# The impersonator itself (main.py): registers to Prusa Connect, uploads
# /c/info + snapshots, runs signaling + WebRTC. Binds :80 via CAP_NET_BIND_SERVICE.
[Unit]
Description=Prusa Camera Impersonator
After=network-online.target
Wants=network-online.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
Type=simple
User=pi
WorkingDirectory=/home/pi/prusa-cam
ExecStart=/home/pi/prusa-cam/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
