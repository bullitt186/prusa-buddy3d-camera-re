# The impersonator itself (main.py): registers to Prusa Connect, uploads
# /c/info + snapshots, runs signaling + WebRTC. Binds :80 via CAP_NET_BIND_SERVICE.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=Prusa Camera Impersonator
After=network-online.target data-ready.target
Wants=network-online.target
Requires=data-ready.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
Type=simple
User=prusa-cam
WorkingDirectory=/opt/prusa-cam
ExecStart=/opt/prusa-cam/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
