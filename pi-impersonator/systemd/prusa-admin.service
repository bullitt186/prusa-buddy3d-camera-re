# Post-claim admin HTTP UI (admin_app.py), the thin aiohttp transport over the
# stdlib admin_http core. Binds :443 over HTTPS at
# https://buddy3d-<device-id>.local. The port is below 1024, so
# CAP_NET_BIND_SERVICE is required.
#
# This unit is pulled by prusa-camera.target (its [Install]
# WantedBy=prusa-camera.target), so the admin UI is only reachable after claim.
# The pre-claim captive portal is served by prusa-provisioning.service instead,
# bound to the setup hotspot at http://192.168.4.1.
#
# TLS is optional: ADMIN_TLS_CERT/ADMIN_TLS_KEY in /etc/prusa-cam/admin.env
# enable it; without them the port serves plain HTTP.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=Buddy3D camera admin / provisioning UI
After=network-online.target data-ready.target
Wants=network-online.target
Requires=data-ready.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=prusa-cam
WorkingDirectory=/opt/prusa-cam
Environment=ADMIN_MODE=admin
EnvironmentFile=-/etc/prusa-cam/admin.env
ExecStart=/opt/prusa-cam/venv/bin/python /opt/prusa-cam/admin_app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=prusa-camera.target
