# Daily signed-application-update check (WP-R4b / AC-30). The timer triggers
# prusa-updater.service once per day with a randomized delay; the check itself
# also enforces a 24 h interval with jitter through the persisted last-check
# timestamp, so a reboot does not cause an immediate re-check storm.
#
# Enabled at multi-user.target. prusa-camera.target additionally Wants= this
# timer (never Requires=), so an update failure stays isolated from the camera
# runtime (AC-27).
[Unit]
Description=Daily Buddy3D signed application update check (24 h + jitter)

[Timer]
OnBootSec=15min
OnUnitActiveSec=24h
RandomizedDelaySec=1h
Persistent=false
Unit=prusa-updater.service

[Install]
WantedBy=multi-user.target
