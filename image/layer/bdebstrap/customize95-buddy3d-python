#!/bin/bash
# Buddy3D image Python dependency hook — explicit no-op (WP-R3 / AC-14).
#
# The runtime venv at /opt/prusa-cam/venv is owned by
# image/assets/install-factory-app.sh, which the buddy3d-image layer invokes
# from its mmdebstrap customize-hooks. That installer runs after the factory
# app directory exists, so `python3 -m venv --system-site-packages` and
# `pip install --require-hashes` always operate on a populated /opt/prusa-cam.
#
# This bdebstrap bundle hook's ordering relative to the layer customize-hooks
# is not guaranteed by the builder, so it must NOT build the venv itself. It
# is kept as an explicit no-op that documents the ownership boundary and exits
# 0, rather than a stub that silently omits the dependency closure.
#
# The hash-locked dependency set is image/requirements.lock: aiohttp,
# python-socketio, paho-mqtt, and their transitive deps, installed with
# --require-hashes --no-cache-dir. Native components (PyGObject, GStreamer,
# libcamera/rpicam, NetworkManager, Samba) stay Debian packages.
set -eu

root="${1:-}"
echo "buddy3d-image: customize95-buddy3d-python is a no-op;" >&2
echo "buddy3d-image: /opt/prusa-cam/venv is created by install-factory-app.sh" >&2
echo "buddy3d-image: from the layer customize-hooks (root=${root:-unset})." >&2
exit 0
