# Image-only runtime target (AC-12). Groups and orders the reused
# pi-impersonator/systemd units per source §3.2:
#
#   data-ready.target -> prusa-camera.target
#     -> pi-persist -> rpicam-source -> prusa-rtsp -> prusa-ha-rtsp -> prusa-cam
#
# Intra-service ordering is already encoded in the reused unit files
# (pi-persist Before the camera units; prusa-rtsp/prusa-ha-rtsp After
# rpicam-source). This target adds the explicit data-ready gate and the
# grouping so later WPs (MQTT/admin/updater) attach here.
[Unit]
Description=Buddy3D camera runtime target (source, signaling, RTSP, admin)
Requires=data-ready.target
After=data-ready.target
# The setup runtime and the camera runtime are mutually exclusive (AC-12): the
# wizard's finish step starts this target, which stops prusa-provisioning.service.
# Ordering after it (AC-18) means the camera units cannot start while the
# provisioning process — which may still hold the sensor during QR capture/probe
# — is shutting down.
Conflicts=prusa-provisioning.service
After=prusa-provisioning.service

# Reused units, activated and awaited by this target. prusa-admin.service is
# pulled here (its [Install] WantedBy=prusa-camera.target), so the admin UI is
# only reachable after claim. prusa-updater.timer (WP-R4b) is pulled with Wants=
# so the update check is available after claim without gating camera startup.
Wants=pi-persist.service rpicam-source.service prusa-rtsp.service prusa-ha-rtsp.service prusa-cam.service prusa-admin.service prusa-updater.timer
After=pi-persist.service rpicam-source.service prusa-rtsp.service prusa-ha-rtsp.service prusa-cam.service prusa-admin.service

# Optional units (prusa-mqtt.service; added by later WPs) must be Wants=, never
# Requires=, so a WS-Discovery/MQTT/admin/update failure never stops the source,
# Prusa registration/signaling, snapshots, RTSP, or WebRTC (AC-27). The updater
# timer above is likewise optional and isolated.

[Install]
WantedBy=multi-user.target
